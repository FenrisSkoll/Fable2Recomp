{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fable2recomp.example/schemas/fable2-gpu-divergence-matrix-v1.schema.json",
  "title": "Fable II G1.5C ReXGlue and Xenia Canary divergence matrix",
  "type": "object",
  "required": [
    "schema_version",
    "corpus",
    "generated_on",
    "pins",
    "records",
    "counts"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "corpus": { "const": "Fable II Native Renderer G1.5C" },
    "generated_on": { "type": "string", "format": "date" },
    "pins": {
      "type": "object",
      "required": [
        "fable_repository",
        "rexglue_repository",
        "canary_repository",
        "active_gpu_artifact"
      ],
      "properties": {
        "fable_repository": { "$ref": "#/$defs/repository" },
        "rexglue_repository": { "$ref": "#/$defs/repository" },
        "canary_repository": { "$ref": "#/$defs/repository" },
        "active_gpu_artifact": {
          "type": "object",
          "required": ["filename", "size", "sha256", "backend"],
          "properties": {
            "filename": { "const": "rexgpu-xenos.dll" },
            "size": { "type": "integer" },
            "sha256": { "pattern": "^[0-9A-F]{64}$" },
            "backend": { "type": "string" }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 30,
      "items": { "$ref": "#/$defs/divergence_record" }
    },
    "counts": {
      "type": "object",
      "required": [
        "records",
        "by_direction",
        "by_primary_classification",
        "by_source_confidence",
        "by_rationale_confidence",
        "by_fable_relevance"
      ]
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["path", "branch", "commit", "tree"],
      "properties": {
        "path": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "pattern": "^[0-9a-f]{40}$" },
        "tree": { "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "locator": {
      "type": "object",
      "required": ["path", "symbols"],
      "properties": {
        "path": { "type": "string" },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["repository", "commit", "paths", "summary"],
      "properties": {
        "repository": { "enum": ["rexglue", "canary"] },
        "commit": { "pattern": "^[0-9a-f]{40}$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locator" }
        },
        "summary": { "type": "string" }
      }
    },
    "classification": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "$ref": "#/$defs/category" },
        "secondary": {
          "type": "array",
          "items": { "$ref": "#/$defs/category" }
        }
      }
    },
    "category": {
      "enum": [
        "XENOS ACCURACY CORRECTION",
        "TITLE COMPATIBILITY FIX",
        "PERFORMANCE OPTIMIZATION",
        "ARCHITECTURE REFACTOR",
        "HOST BACKEND/API ADAPTATION",
        "HOST CAPABILITY OR CONFIGURATION PATH",
        "DIAGNOSTIC/ROBUSTNESS CHANGE",
        "REXGLUE-SPECIFIC INTEGRATION",
        "REMOVED OR DISABLED BEHAVIOUR",
        "UNKNOWN"
      ]
    },
    "divergence_record": {
      "type": "object",
      "required": [
        "record_id",
        "subsystem",
        "behaviour",
        "source_confidence",
        "rexglue",
        "canary",
        "direction",
        "material_divergences",
        "classification",
        "historical_provenance",
        "rationale_confidence",
        "preliminary_fable",
        "preliminary_renderer_implication",
        "open_questions"
      ],
      "properties": {
        "record_id": { "pattern": "^[A-Z]{2,3}-[0-9]{3}$" },
        "subsystem": { "type": "string" },
        "behaviour": { "type": "string" },
        "source_confidence": {
          "enum": ["CONFIRMED", "PROBABLE", "UNKNOWN", "NOT APPLICABLE"]
        },
        "rexglue": { "$ref": "#/$defs/implementation" },
        "canary": { "$ref": "#/$defs/implementation" },
        "direction": {
          "enum": [
            "CANARY-ONLY",
            "REXGLUE-ONLY",
            "SEMANTICALLY DIFFERENT",
            "SAME BEHAVIOUR, DIFFERENT STRUCTURE",
            "INSUFFICIENT EVIDENCE"
          ]
        },
        "material_divergences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "classification": { "$ref": "#/$defs/classification" },
        "historical_provenance": {
          "type": "object",
          "required": ["history_ids", "summary"],
          "properties": {
            "history_ids": {
              "type": "array",
              "items": { "pattern": "^(CAN|REX)-[A-Za-z0-9-]+$" }
            },
            "summary": { "type": "string" }
          }
        },
        "rationale_confidence": {
          "enum": [
            "CONFIRMED RATIONALE",
            "INFERRED RATIONALE",
            "RATIONALE UNKNOWN",
            "NOT APPLICABLE"
          ]
        },
        "preliminary_fable": {
          "type": "object",
          "required": ["relevance", "evidence", "evidence_required"],
          "properties": {
            "relevance": {
              "enum": [
                "CONFIRMED RELEVANT",
                "PROBABLE RELEVANT",
                "UNKNOWN FOR FABLE II",
                "NOT OBSERVED FOR FABLE II",
                "NOT APPLICABLE TO FABLE II"
              ]
            },
            "evidence": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidence_required": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "preliminary_renderer_implication": { "type": "string" },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
