{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fable2recomp.example/schemas/fable2-gpu-experiment-backlog-v1.schema.json",
  "title": "Fable II G1.5D minimum evidence experiment backlog",
  "type": "object",
  "required": [
    "schema_version",
    "corpus",
    "generated_on",
    "pins",
    "capture_root_contract",
    "experiments",
    "counts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "corpus": {
      "const": "Fable II Native Renderer G1.5D"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "pins": {
      "type": "object"
    },
    "capture_root_contract": {
      "type": "object",
      "required": [
        "requirement",
        "forbidden_locations",
        "verification"
      ]
    },
    "experiments": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "experiments",
        "by_type",
        "by_estimated_evidence_level"
      ]
    }
  },
  "$defs": {
    "experiment": {
      "type": "object",
      "required": [
        "experiment_id",
        "order",
        "type",
        "question_answered",
        "hypothesis",
        "exact_source_symbol_or_guest_boundary",
        "minimum_fields_required",
        "data_explicitly_forbidden",
        "default_off_fail_open_requirements",
        "control_run",
        "user_action",
        "criteria",
        "rollback",
        "risk_and_privacy_classification",
        "dependencies",
        "decision_unlocked",
        "estimated_evidence_level"
      ],
      "properties": {
        "experiment_id": {
          "pattern": "^EXP-[A-Z0-9-]+$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "STATIC",
            "BUILD/ABI",
            "RUNTIME METADATA",
            "CONTROLLED A/B",
            "USER CHECKPOINT"
          ]
        },
        "question_answered": {
          "type": "string"
        },
        "hypothesis": {
          "type": "string"
        },
        "exact_source_symbol_or_guest_boundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "minimum_fields_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_explicitly_forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "default_off_fail_open_requirements": {
          "type": "object",
          "required": [
            "default_off",
            "fail_open",
            "requirements"
          ]
        },
        "control_run": {
          "type": "string"
        },
        "user_action": {
          "type": "string"
        },
        "criteria": {
          "type": "object",
          "required": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "rollback": {
          "type": "string"
        },
        "risk_and_privacy_classification": {
          "type": "object",
          "required": [
            "risk",
            "privacy",
            "notes"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "pattern": "^EXP-[A-Z0-9-]+$"
          }
        },
        "decision_unlocked": {
          "type": "string"
        },
        "estimated_evidence_level": {
          "pattern": "^L[0-5]$"
        }
      }
    }
  }
}
