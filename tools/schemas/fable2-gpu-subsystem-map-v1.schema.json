{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fable2recomp.example/schemas/fable2-gpu-subsystem-map-v1.schema.json",
  "title": "Fable II GPU reference subsystem map",
  "type": "object",
  "required": [
    "schema_version",
    "corpus",
    "pinned_rexglue_commit",
    "confidence_vocabulary",
    "subsystems",
    "relationships",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "corpus": { "const": "Fable II Native Renderer G1.5A" },
    "pinned_rexglue_commit": { "pattern": "^[0-9a-f]{40}$" },
    "confidence_vocabulary": {
      "type": "array",
      "const": ["CONFIRMED", "PROBABLE", "UNKNOWN", "NOT APPLICABLE"]
    },
    "subsystems": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "coverage",
          "inputs",
          "persistent_state",
          "outputs",
          "xenos_vs_rexglue",
          "backend_boundary",
          "symbols",
          "fable_connection",
          "unresolved"
        ],
        "properties": {
          "coverage": { "enum": ["FULL", "PARTIAL", "NOT DOCUMENTED"] },
          "symbols": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["repository", "path", "type", "symbol", "confidence", "role"],
              "properties": {
                "confidence": {
                  "enum": ["CONFIRMED", "PROBABLE", "UNKNOWN", "NOT APPLICABLE"]
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "kind", "confidence", "symbols"],
        "properties": {
          "confidence": {
            "enum": ["CONFIRMED", "PROBABLE", "UNKNOWN", "NOT APPLICABLE"]
          }
        }
      }
    },
    "unresolved_questions": { "type": "array" }
  }
}
