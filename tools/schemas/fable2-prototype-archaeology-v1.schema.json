{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fable2recomp.local/schemas/fable2-prototype-archaeology-v1.schema.json",
  "title": "Fable II prototype archaeology Phase 1 artifact envelope",
  "type": "object",
  "required": [
    "schema",
    "generator",
    "generated_at_utc"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^fable2-prototype-"
        },
        "version": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "Fable2PrototypeArchaeology.py"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
