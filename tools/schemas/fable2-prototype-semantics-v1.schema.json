{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fable2:prototype-semantics:1",
  "title": "Phase 2B semantic evidence family, version 1",
  "description": "Shape contract plus mandatory cross-artifact invariants in Fable2PrototypeSemantics.validate_family. Binary correspondence is not semantic naming or canonical adoption.",
  "type": "object",
  "required": ["schema", "generator", "phase2a_closeout", "phase2a_input_bundle_sha256", "timestamp_policy"],
  "properties": {
    "schema": {"type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": {
      "name": {"enum": ["fable2-prototype-semantics-source-pins", "fable2-prototype-semantics-inventory", "fable2-prototype-semantics-xrefs", "fable2-prototype-semantics-registrations", "fable2-prototype-semantics-index", "fable2-prototype-semantics-accepted", "fable2-prototype-semantics-review", "fable2-prototype-semantics-mapping-review", "fable2-prototype-semantics-graph", "fable2-prototype-semantics-globals", "fable2-prototype-semantics-validation"]},
      "version": {"const": 1}
    }},
    "generator": {"type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": {"name": {"const": "Fable2PrototypeSemantics.py"}, "version": {"const": "1.0.0"}}},
    "phase2a_closeout": {"const": "6ce54cbdcaa9fef23c6cd13e86fe46d3783cf3fd"},
    "phase2a_input_bundle_sha256": {"const": "DA77AF8D9345C684F81FDD342CDB1E95E48CC826A374D783EEC561F1EDE42B2F"},
    "timestamp_policy": {"const": "omitted-no-clock-input"},
    "source_pins_sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"if": {"properties": {"schema": {"properties": {"name": {"const": "fable2-prototype-semantics-source-pins"}}}}}, "then": {"required": ["sources", "community", "sdk_start", "fable_start", "python_runtime"], "properties": {"sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "community": {"type": "object", "required": ["url", "commit", "expected_sha256", "classification", "status"]}, "sdk_start": {"type": "object", "required": ["branch", "head", "tree", "status", "remotes", "libmspack"]}, "fable_start": {"type": "object", "required": ["branch", "head", "tree", "status", "remotes"]}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"const": "fable2-prototype-semantics-inventory"}}}}}, "then": {"required": ["source_pins_sha256", "anchors"], "properties": {"anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"const": "fable2-prototype-semantics-xrefs"}}}}}, "then": {"required": ["source_pins_sha256", "references", "data_pointers"], "properties": {"references": {"type": "array", "items": {"$ref": "#/$defs/xref"}}, "data_pointers": {"type": "array", "items": {"type": "object", "required": ["id", "build", "slot", "anchor_address", "method", "function"], "properties": {"function": {"type": "null"}, "method": {"const": "direct-big-endian-pointer"}}}}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"const": "fable2-prototype-semantics-registrations"}}}}}, "then": {"required": ["source_pins_sha256", "records"], "properties": {"records": {"type": "array", "items": {"type": "object", "required": ["id", "build", "name_address", "callback", "callback_boundary", "status", "reasons"], "properties": {"status": {"enum": ["quarantined", "proven-native-descriptor"]}, "callback_boundary": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/boundary"}]}, "reasons": {"type": "array", "items": {"type": "string"}}}, "allOf": [{"if": {"properties": {"status": {"const": "proven-native-descriptor"}}}, "then": {"required": ["registration_function", "call_instruction", "callee", "name_store", "callback_store", "compatible_repetitions"], "properties": {"compatible_repetitions": {"type": "integer", "minimum": 2}, "reasons": {"maxItems": 0}, "callback_boundary": {"$ref": "#/$defs/boundary"}}}}]}}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"enum": ["fable2-prototype-semantics-index", "fable2-prototype-semantics-accepted"]}}}}}, "then": {"required": ["source_pins_sha256", "records"], "properties": {"records": {"type": "array", "items": {"$ref": "#/$defs/association"}}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"const": "fable2-prototype-semantics-accepted"}}}}}, "then": {"properties": {"records": {"items": {"properties": {"status": {"enum": ["accepted-registered-callback", "accepted-xref-corroborated"]}, "mapping": {"type": "object"}, "target_corroboration": {"minItems": 1}, "contradictions": {"maxItems": 0}}}}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"const": "fable2-prototype-semantics-review"}}}}}, "then": {"required": ["source_pins_sha256", "records", "availability", "problem_sets"], "properties": {"records": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stratum", "association_id"], "properties": {"stratum": {"type": "string"}, "association_id": {"type": "string"}}}}, "availability": {"type": "object", "additionalProperties": {"type": "object", "required": ["available", "selected"], "properties": {"available": {"type": "integer", "minimum": 0}, "selected": {"type": "integer", "minimum": 0, "maximum": 3}}}}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"const": "fable2-prototype-semantics-mapping-review"}}}}}, "then": {"required": ["source_pins_sha256", "records"], "properties": {"records": {"type": "array", "items": {"type": "object", "required": ["id", "association_id", "blocking_status", "reason", "contradictions", "mapping_changed"], "properties": {"mapping_changed": {"const": false}}}}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"enum": ["fable2-prototype-semantics-graph", "fable2-prototype-semantics-globals"]}}}}}, "then": {"required": ["source_pins_sha256", "records"], "properties": {"records": {"type": "array", "items": {"type": "object", "required": ["semantic_acceptance"], "properties": {"semantic_acceptance": {"const": false}}}}}}},
    {"if": {"properties": {"schema": {"properties": {"name": {"const": "fable2-prototype-semantics-validation"}}}}}, "then": {"required": ["source_pins_sha256", "counts", "artifacts", "implementation", "policies"], "properties": {"counts": {"type": "object", "required": ["sources", "anchors", "instruction_xrefs", "registration_records", "joins", "accepted", "statuses", "blocked_by_status"]}, "artifacts": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/binding"}}, "implementation": {"type": "array", "items": {"$ref": "#/$defs/source"}}, "policies": {"type": "object", "required": ["canonical_adoption", "scores_create_acceptance"], "properties": {"canonical_adoption": {"const": false}, "scores_create_acceptance": {"const": false}}}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "address": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
    "binding": {"type": "object", "required": ["path", "size", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\./).+$"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/hash"}}},
    "source": {"allOf": [{"$ref": "#/$defs/binding"}, {"required": ["root", "kind"], "properties": {"root": {"enum": ["repository", "corpus"]}, "kind": {"type": "string"}}}]},
    "boundary": {"type": "object", "required": ["start", "end_exclusive", "size", "pdata_record"], "additionalProperties": false, "properties": {"start": {"$ref": "#/$defs/address"}, "end_exclusive": {"$ref": "#/$defs/address"}, "size": {"type": "integer", "minimum": 4, "multipleOf": 4}, "pdata_record": {"$ref": "#/$defs/address"}}},
    "anchor": {
      "type": "object",
      "required": ["id", "spelling", "lookup_key", "provenance", "categories", "occurrences", "subsystem", "filters", "duplicate_provenance_count"],
      "properties": {
        "id": {"type": "string", "pattern": "^A-[0-9A-F]{24}$"},
        "spelling": {"type": "string", "minLength": 1},
        "lookup_key": {"type": "string"},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "json_pointer", "build", "location"]}},
        "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["distinctive-debug-lua-command", "rtti-type-name", "assertion-diagnostic", "source-path-filename", "subsystem-profiling-label", "renderer-debug-label", "generic-string", "external-only-observation"]}},
        "occurrences": {"type": "array", "items": {"type": "object", "required": ["build", "address", "section", "offset", "encoding", "match", "native_spelling", "source"], "properties": {"address": {"$ref": "#/$defs/address"}, "offset": {"type": "integer", "minimum": 0}, "match": {"enum": ["exact", "terminal-candidate"]}}}},
        "filters": {"type": "array", "items": {"type": "string"}},
        "duplicate_provenance_count": {"type": "integer", "minimum": 0}
      }
    },
    "xref": {"type": "object", "required": ["id", "build", "anchor_address", "instruction", "function", "method", "role", "operand", "width", "destination", "definition_instructions", "readonly_pointer_slots", "checks"], "properties": {"function": {"$ref": "#/$defs/boundary"}, "anchor_address": {"$ref": "#/$defs/address"}, "instruction": {"$ref": "#/$defs/address"}, "method": {"const": "bounded-def-use"}, "role": {"enum": ["call-argument", "store", "memory-read", "memory-write"]}, "definition_instructions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/address"}}, "readonly_pointer_slots": {"type": "array", "items": {"$ref": "#/$defs/address"}}}},
    "association": {"type": "object", "required": ["id", "anchor_id", "build", "kind", "donor_function", "donor_xrefs", "mapping", "target_corroboration", "contradictions", "status", "reason", "correspondence_block", "proposed_name", "canonical_adoption", "intersections"], "properties": {"status": {"enum": ["accepted-registered-callback", "accepted-xref-corroborated", "candidate-target-unconfirmed", "candidate-donor-only", "ambiguous", "quarantined", "rejected"]}, "donor_function": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/boundary"}]}, "donor_xrefs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "mapping": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["source", "record_index", "record"], "properties": {"record_index": {"type": "integer", "minimum": 0}, "record": {"type": "object", "required": ["donor_start", "donor_end_exclusive", "target_start", "target_end_exclusive", "status"], "properties": {"status": {"enum": ["accepted-exact-unique", "accepted-normalized-corroborated"]}}}}}]}, "target_corroboration": {"type": "array", "items": {"type": "object", "required": ["kind", "callee_mapping_index"], "properties": {"kind": {"enum": ["same-distinctive-anchor-same-argument-mapped-callee", "proven-equivalent-descriptor"]}}}}, "contradictions": {"type": "array"}, "proposed_name": {"type": "null"}, "canonical_adoption": {"const": false}, "intersections": {"type": "array", "items": {"type": "object", "required": ["set", "address", "source", "json_pointer", "disposition"]}}}}
  }
}
