{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fable2recomp.invalid/schemas/fable2-save-diagnostic-report-v1.schema.json",
  "title": "Fable II native-save diagnostic report v1",
  "type": "object",
  "required": [
    "schema_version",
    "trace_event_schema_version",
    "save_root",
    "event_count",
    "classifications",
    "tree_comparison",
    "save_snapshot"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "trace_event_schema_version": { "const": 1 },
    "save_root": { "type": "string", "minLength": 1 },
    "event_count": { "type": "integer", "minimum": 0 },
    "classifications": { "type": "array", "minItems": 1 },
    "tree_comparison": { "type": "object" },
    "restart_observation": {
      "type": "object",
      "required": [
        "enumerated_item_count_max",
        "required_payload_opened",
        "all_required_payload_opened",
        "nt_read_file_traced"
      ],
      "properties": {
        "enumerated_item_count_max": { "type": "integer", "minimum": 0 },
        "required_payload_opened": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "all_required_payload_opened": { "type": "boolean" },
        "nt_read_file_traced": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "update_observation": {
      "type": "object",
      "required": [
        "first_content_write_mount_sequence",
        "first_write_sequence",
        "files_written",
        "write_request_count",
        "requested_write_bytes",
        "actual_write_bytes",
        "missing_write_result_count",
        "short_write_count",
        "failed_write_count",
        "all_writes_completed",
        "read_request_count",
        "missing_read_result_count",
        "end_of_file_read_count",
        "non_eof_read_failure_count",
        "content_changed_paths",
        "metadata_changed_paths"
      ],
      "properties": {
        "first_content_write_mount_sequence": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "first_write_sequence": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "files_written": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "write_request_count": { "type": "integer", "minimum": 0 },
        "requested_write_bytes": { "type": "integer", "minimum": 0 },
        "actual_write_bytes": { "type": "integer", "minimum": 0 },
        "missing_write_result_count": { "type": "integer", "minimum": 0 },
        "short_write_count": { "type": "integer", "minimum": 0 },
        "failed_write_count": { "type": "integer", "minimum": 0 },
        "all_writes_completed": { "type": "boolean" },
        "read_request_count": { "type": "integer", "minimum": 0 },
        "missing_read_result_count": { "type": "integer", "minimum": 0 },
        "end_of_file_read_count": { "type": "integer", "minimum": 0 },
        "non_eof_read_failure_count": { "type": "integer", "minimum": 0 },
        "content_changed_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "metadata_changed_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "payload_contract": {
      "type": "object",
      "required": ["required_fresh_slot", "conditional_later_state"],
      "properties": {
        "required_fresh_slot": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conditional_later_state": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "save_snapshot": { "type": "object" }
  },
  "additionalProperties": true
}
